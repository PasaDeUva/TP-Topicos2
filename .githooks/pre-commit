#!/bin/sh
set -eu

if ! git diff --cached --check; then
  echo "El commit contiene errores de whitespace." >&2
  exit 1
fi

repo_root="$(git rev-parse --show-toplevel)"

backend_python=""
for candidate in \
  "$repo_root/backend/identity-service/.venv/Scripts/python.exe" \
  "$repo_root/backend/identity-service/.venv/bin/python" \
  "$repo_root/backend/events-service/.venv/Scripts/python.exe" \
  "$repo_root/backend/events-service/.venv/bin/python" \
  "$repo_root/backend/compras-service/.venv/Scripts/python.exe" \
  "$repo_root/backend/compras-service/.venv/bin/python" \
  python3 \
  python; do
  if [ -x "$candidate" ] || command -v "$candidate" >/dev/null 2>&1; then
    if "$candidate" -m ruff --version >/dev/null 2>&1; then
      backend_python="$candidate"
      break
    fi
  fi
done

if [ -z "$backend_python" ]; then
  echo "No se encontró un intérprete de Python con ruff instalado. Creá el entorno de un servicio e instalá dependencias." >&2
  exit 1
fi

"$backend_python" -m ruff check "$repo_root/backend"
npm --prefix "$repo_root/frontend/web-app" run lint
