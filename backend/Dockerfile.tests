FROM python:3.12-slim

WORKDIR /workspace

COPY . .

RUN set -eux; \
    for service in */; do \
      if [ -f "$service/requirements-dev.txt" ]; then \
        pip install --no-cache-dir -r "$service/requirements-dev.txt"; \
      elif [ -f "$service/requirements.txt" ]; then \
        pip install --no-cache-dir -r "$service/requirements.txt"; \
      fi; \
    done

CMD ["sh", "-c", "set -eu; found=0; for service in */; do if [ -d \"$service/tests\" ]; then found=1; echo \"Running tests for $service\"; (cd \"$service\" && pytest -q); fi; done; test \"$found\" -eq 1"]
