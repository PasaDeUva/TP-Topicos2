# ==========================================
# Configuración del Entorno Local (Docker)
# ==========================================

# Seguridad y Sesión Web (Identity)
IDENTITY_WEB_CSRF_SECRET=topicos2-secret-csrf-token-development-2026
IDENTITY_WEB_ORIGINS=http://localhost:5174
IDENTITY_WEB_ALLOW_LOCAL_HTTP=true

# Comunicación entre Microservicios
CONSUMER_ENV=local
IDENTITY_ALLOW_LOCAL_HTTP=true
IDENTITY_SERVICE_URL=http://identity-service:8000
IDENTITY_TIMEOUT_SECONDS=0.8

# Tokens y Credenciales de Servicio
IDENTITY_EVENTS_SERVICE_TOKEN=local-events-token
IDENTITY_PURCHASES_SERVICE_TOKEN=local-purchases-token
IDENTITY_SERVICE_CREDENTIALS_JSON={"events":{"token":"local-events-token","roles_read":true,"sessions_read":true},"purchases":{"token":"local-purchases-token","roles_read":true,"sessions_read":true}}

# Administrador Inicial de Identity
IDENTITY_ADMIN_EMAIL=admin@example.com
IDENTITY_ADMIN_PASSWORD=local-admin-password

# Puertos en el Host (Opcionales, valores predeterminados)
WEB_APP_HOST_PORT=5174
IDENTITY_HOST_PORT=8002
EVENTS_SERVICE_HOST_PORT=8001
COMPRAS_SERVICE_HOST_PORT=8003
IDENTITY_DB_HOST_PORT=5435
EVENTS_DB_HOST_PORT=5433
COMPRAS_DB_HOST_PORT=5436
